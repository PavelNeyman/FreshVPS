# FreshVPS non-interactive config
# sudo bash install.sh --config /root/freshvps.conf --non-interactive

PUBLIC_IP=
SSH_PORT=22

ENABLE_HARDENING=1
ENABLE_SINGBOX=1
ENABLE_BLOCKY=1
ENABLE_VPN_USERS=1
ENABLE_VPN_API=1
ENABLE_OPENSOHO=1
ENABLE_KUMA=1
ENABLE_BESZEL=1
ENABLE_TELEGRAM=1
ENABLE_BACKUP=1

SINGBOX_VLESS_PORT=443
SINGBOX_HY2_PORT=8443
SINGBOX_REALITY_SNI=www.cloudflare.com

BLOCKY_DNS_PORT=53
OPENSOHO_HTTP_PORT=8090
KUMA_PORT=3001
BESZEL_PORT=8091
VPN_API_PORT=8787
VPN_API_BIND=127.0.0.1

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

BACKUP_REPO=
