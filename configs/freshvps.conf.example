# FreshVPS non-interactive config (source as bash)
# sudo bash install.sh --config configs/freshvps.conf.example --non-interactive

PUBLIC_IP=
SSH_PORT=22

ENABLE_HARDENING=1
ENABLE_SINGBOX=1
ENABLE_BLOCKY=1
ENABLE_OPENSOHO=1
ENABLE_KUMA=1
ENABLE_BESZEL=1
ENABLE_TELEGRAM=1
ENABLE_BACKUP=1

SINGBOX_VLESS_PORT=443
SINGBOX_HY2_PORT=8443
SINGBOX_REALITY_SNI=www.cloudflare.com

BLOCKY_DNS_PORT=53
OPENSOHO_HTTP_PORT=8090
KUMA_PORT=3001
BESZEL_PORT=8091

# Optional — leave empty to configure later under /etc/freshvps/secrets/
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# restic local repo path (default /var/backups/freshvps/repo)
BACKUP_REPO=
