#!/usr/bin/env bash
set -euo pipefail
ok=0
fail=0
check() {
  local name="$1"; shift
  if "$@" >/dev/null 2>&1; then echo "OK   ${name}"; ok=$((ok+1))
  else echo "FAIL ${name}"; fail=$((fail+1)); fi
}
echo "FreshVPS doctor — $(hostname) $(date -Iseconds)"
if [[ -f /var/lib/freshvps/installed_version ]]; then
  echo "INFO installed_version=$(cat /var/lib/freshvps/installed_version)"
fi
echo
check "debian" test -f /etc/debian_version
check "secrets dir" test -d /etc/freshvps/secrets
check "READY.txt" test -f /etc/freshvps/READY.txt
check "vpn-users.json" test -f /etc/freshvps/vpn-users.json
check "operator artifacts" test -f /etc/freshvps/clients/operator/link.txt -o -f /etc/freshvps/clients/operator/subscription.txt
check "freshvps-vpn" command -v freshvps-vpn
check "sing-box binary" test -x /usr/local/bin/sing-box
check "sing-box unit" systemctl is-active sing-box
check "sing-box config" /usr/local/bin/sing-box check -c /usr/local/etc/sing-box/config.json
check "blocky unit" systemctl is-active blocky
check "dns localhost" dig +time=2 +tries=1 @127.0.0.1 example.com +short
if systemctl list-unit-files 2>/dev/null | grep -q freshvps-api; then
  check "api unit" systemctl is-active freshvps-api
fi
echo; echo "Summary: ok=${ok} fail=${fail}"
[[ "${fail}" -eq 0 ]]
