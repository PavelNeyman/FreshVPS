[Unit]
Description=Netductor API (Go) cutover :8787
After=network-online.target
Wants=network-online.target
Conflicts=freshvps-api.service

[Service]
Type=simple
Environment=FRESHVPS_ADMIN_ROOT=/opt/freshvps/runtime/api/admin
ExecStart=/usr/local/bin/netductor serve --bind 127.0.0.1 --port 8787 --no-proxy
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
