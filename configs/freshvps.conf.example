# FreshVPS non-interactive config
# sudo bash install.sh --config /root/freshvps.conf --non-interactive

PUBLIC_IP=
SSH_PORT=22

ENABLE_HARDENING=1
ENABLE_SINGBOX=1
ENABLE_BLOCKY=1
ENABLE_VPN_USERS=1
ENABLE_VPN_API=1
ENABLE_OPENSOHO=1
ENABLE_KUMA=1
ENABLE_BESZEL=1
ENABLE_TELEGRAM=1
ENABLE_BACKUP=1

SINGBOX_VLESS_PORT=443
SINGBOX_HY2_PORT=8443
SINGBOX_REALITY_SNI=www.cloudflare.com

BLOCKY_DNS_PORT=53
OPENSOHO_HTTP_PORT=8090
KUMA_PORT=3001
BESZEL_PORT=8091
VPN_API_PORT=8787
VPN_API_BIND=127.0.0.1

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

BACKUP_REPO=

# --- Panel admin credentials (optional) ---
# Leave empty to auto-generate a random password and save it under /etc/freshvps/secrets/
# Format:
#   OPENSOHO_ADMIN_EMAIL=admin@example.com
#   OPENSOHO_ADMIN_PASSWORD=YourLongPasswordHere
#   BESZEL_ADMIN_EMAIL=admin@example.com
#   BESZEL_ADMIN_PASSWORD=YourLongPasswordHere
# Email: normal address (used as login). Password: any non-empty string (prefer 16+ chars).
# Uptime Kuma has no CLI setup — create the first user once in the browser.
OPENSOHO_ADMIN_EMAIL=
OPENSOHO_ADMIN_PASSWORD=
BESZEL_ADMIN_EMAIL=
BESZEL_ADMIN_PASSWORD=
