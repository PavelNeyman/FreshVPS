#!/usr/bin/env bash
# freshvps-vpn — operator CLI
set -euo pipefail

ROOT="${FRESHVPS_ROOT:-}"
if [[ -z "${ROOT}" ]]; then
  if [[ -f /opt/freshvps/lib/vpn-core.sh ]]; then
    ROOT=/opt/freshvps
  elif [[ -f "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/vpn-core.sh" ]]; then
    ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  else
    echo "Cannot find FreshVPS root" >&2
    exit 1
  fi
fi

# shellcheck source=/dev/null
source "${ROOT}/lib/common.sh" 2>/dev/null || true
# shellcheck source=/dev/null
source "${ROOT}/lib/vpn-core.sh"

usage() {
  cat <<EOF
freshvps-vpn — manage VPN users (operator only)

  freshvps-vpn add <name> [note]
  freshvps-vpn list
  freshvps-vpn link <name>          # subscription (VLESS+HY2)
  freshvps-vpn link <name> vless    # VLESS only
  freshvps-vpn link <name> hy2      # Hysteria2 only
  freshvps-vpn disable|enable|revoke <name>
  freshvps-vpn apply
  freshvps-vpn session [hours]
  freshvps-vpn api-bind localhost|detect|<ip> [--ufw]
EOF
}

cmd="${1:-}"
shift || true

case "${cmd}" in
  add)
    name="${1:?name}"; note="${2:-}"
    vpn_add_user "${name}" "${note}"
    echo "Subscription:"
    cat "${VPN_CLIENTS_DIR}/${name}/subscription.txt"
    echo "Dir: ${VPN_CLIENTS_DIR}/${name}/"
    ;;
  list) vpn_list_users ;;
  link)
    name="${1:?name}"
    kind="${2:-sub}"
    case "${kind}" in
      vless) cat "${VPN_CLIENTS_DIR}/${name}/link-vless.txt" 2>/dev/null || cat "${VPN_CLIENTS_DIR}/${name}/link.txt" ;;
      hy2) cat "${VPN_CLIENTS_DIR}/${name}/link-hy2.txt" ;;
      *) cat "${VPN_CLIENTS_DIR}/${name}/subscription.txt" 2>/dev/null || cat "${VPN_CLIENTS_DIR}/${name}/link.txt" ;;
    esac
    ;;
  disable) vpn_set_enabled "${1:?name}" false; echo "disabled ${1}" ;;
  enable) vpn_set_enabled "${1:?name}" true; echo "enabled ${1}" ;;
  revoke) vpn_revoke_user "${1:?name}"; echo "revoked ${1}" ;;
  apply) vpn_apply_config; echo "config applied" ;;
  session)
    hours="${1:-72}"
    tok="$(openssl rand -hex 32)"
    exp="$(( $(date +%s) + hours * 3600 ))"
    mkdir -p /etc/freshvps/sessions
    chmod 700 /etc/freshvps/sessions
    printf '%s\n' "${exp}" >"/etc/freshvps/sessions/${tok}"
    chmod 600 "/etc/freshvps/sessions/${tok}"
    echo "${tok}"
    echo "expires_unix=${exp} hours=${hours}" >&2
    ;;
  api-bind)
    if [[ ! -x /opt/freshvps-api/rebind.sh ]]; then
      echo "API module not installed" >&2
      exit 1
    fi
    /opt/freshvps-api/rebind.sh "${1:-localhost}" "${2:-}"
    ;;
  -h|--help|"") usage ;;
  *) echo "unknown: ${cmd}" >&2; usage; exit 1 ;;
esac
