#!/usr/bin/env bash
# Post-install / ops healthcheck (no external deps beyond systemctl/ss)
set -euo pipefail

ok=0
fail=0

check() {
  local name="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    echo "OK   ${name}"
    ok=$((ok + 1))
  else
    echo "FAIL ${name}"
    fail=$((fail + 1))
  fi
}

echo "FreshVPS doctor — $(hostname) $(date -Iseconds)"
echo

check "debian" test -f /etc/debian_version
check "secrets dir" test -d /etc/freshvps/secrets
check "READY.txt" test -f /etc/freshvps/READY.txt
check "public_ip file" test -f /etc/freshvps/public_ip
check "vpn-users.json" test -f /etc/freshvps/vpn-users.json
check "operator link" test -f /etc/freshvps/clients/operator/link.txt
check "freshvps-vpn CLI" command -v freshvps-vpn
check "sing-box binary" test -x /usr/local/bin/sing-box
check "sing-box unit" systemctl is-active sing-box
check "sing-box config" /usr/local/bin/sing-box check -c /usr/local/etc/sing-box/config.json
if [[ -f /etc/freshvps/singbox-config-variant ]]; then
  echo "INFO sing-box config variant: $(cat /etc/freshvps/singbox-config-variant)"
fi
check "blocky unit" systemctl is-active blocky
check "dns localhost" dig +time=2 +tries=1 @127.0.0.1 example.com +short
if systemctl list-unit-files | grep -q freshvps-api; then
  check "api unit" systemctl is-active freshvps-api
  check "api health" curl -fsS --max-time 2 http://127.0.0.1:8787/health
fi
if systemctl list-unit-files | grep -q freshvps-telegram-bot; then
  if [[ -f /etc/freshvps/secrets/telegram_bot_token ]]; then
    check "telegram bot unit" systemctl is-active freshvps-telegram-bot
  else
    echo "SKIP telegram bot (no token)"
  fi
fi

echo
echo "Summary: ok=${ok} fail=${fail}"
[[ "${fail}" -eq 0 ]]
