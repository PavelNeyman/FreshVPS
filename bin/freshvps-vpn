#!/usr/bin/env bash
# DEPRECATED: use `netductor vpn ...`. This wrapper forwards when possible.
set -euo pipefail
if command -v netductor >/dev/null 2>&1; then
  case "${1:-}" in
    add|list|link|note|disable|enable|revoke|apply|session|edge-list|edge-cmd|api-bind)
      exec netductor vpn "$@"
      ;;
  esac
fi
ROOT="${FRESHVPS_ROOT:-}"
if [[ -z "${ROOT}" ]]; then
  if [[ -f /opt/freshvps/lib/vpn-core.sh ]]; then ROOT=/opt/freshvps
  elif [[ -f "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/vpn-core.sh" ]]; then
    ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  else
    echo "netductor/freshvps root not found" >&2; exit 1
  fi
fi
# shellcheck source=/dev/null
source "${ROOT}/lib/common.sh" 2>/dev/null || true
# shellcheck source=/dev/null
source "${ROOT}/lib/vpn-core.sh"
cmd="${1:-}"; shift || true
case "${cmd}" in
  add) vpn_add_user "${1:?}" "${2:-}"; cat "${VPN_CLIENTS_DIR}/${1}/subscription.txt" ;;
  list) vpn_list_users ;;
  link)
    n="${1:?}"; k="${2:-sub}"
    case "$k" in vless) cat "${VPN_CLIENTS_DIR}/$n/link-vless.txt" 2>/dev/null || cat "${VPN_CLIENTS_DIR}/$n/link.txt" ;;
      hy2) cat "${VPN_CLIENTS_DIR}/$n/link-hy2.txt" ;;
      *) cat "${VPN_CLIENTS_DIR}/$n/subscription.txt" 2>/dev/null || cat "${VPN_CLIENTS_DIR}/$n/link.txt" ;; esac ;;
  note) vpn_set_note "${1:?}" "${2:-}" ;;
  disable) vpn_set_enabled "${1:?}" false ;;
  enable) vpn_set_enabled "${1:?}" true ;;
  revoke) vpn_revoke_user "${1:?}" ;;
  apply) vpn_apply_config ;;
  session|edge-list|edge-cmd|api-bind)
    echo "install netductor for $cmd" >&2; exit 1 ;;
  *) echo "usage: freshvps-vpn (deprecated) → netductor vpn ..." >&2; exit 1 ;;
esac
