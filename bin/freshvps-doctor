#!/usr/bin/env bash
set -euo pipefail
ok=0
fail=0
warnn=0
check() {
  local name="$1"; shift
  if "$@" >/dev/null 2>&1; then echo "OK   ${name}"; ok=$((ok+1))
  else echo "FAIL ${name}"; fail=$((fail+1)); fi
}
warn_check() {
  local name="$1"; shift
  if "$@" >/dev/null 2>&1; then echo "OK   ${name}"; ok=$((ok+1))
  else echo "WARN ${name}"; warnn=$((warnn+1)); fi
}

_container_running() {
  local c="$1"
  docker inspect -f '{{.State.Running}}' "${c}" 2>/dev/null | grep -qi true
}

echo "FreshVPS doctor — $(hostname) $(date -Iseconds)"
[[ -f /var/lib/freshvps/installed_version ]] && echo "INFO installed_version=$(cat /var/lib/freshvps/installed_version)"
[[ -f /etc/freshvps/install.conf ]] && echo "INFO install.conf present"
if [[ -f /etc/freshvps/singbox-config-variant ]]; then
  v="$(cat /etc/freshvps/singbox-config-variant)"
  echo "INFO sing-box config variant=${v}"
  if [[ "${v}" != "a" ]]; then
    echo "WARN preferred DNS/route variant is 'a'; got '${v}'"
    warnn=$((warnn+1))
  fi
fi
echo

check "debian" test -f /etc/debian_version
check "secrets" test -d /etc/freshvps/secrets
check "READY.txt" test -f /etc/freshvps/READY.txt
check "vpn-users.json" test -f /etc/freshvps/vpn-users.json
check "operator subscription" test -f /etc/freshvps/clients/operator/subscription.txt
check "freshvps-vpn" command -v freshvps-vpn
check "freshvps-tests" command -v freshvps-tests
check "smoke-host" test -x /opt/freshvps/scripts/smoke-host.sh
check "sing-box binary" test -x /usr/local/bin/sing-box
check "sing-box unit" systemctl is-active sing-box
check "sing-box config" /usr/local/bin/sing-box check -c /usr/local/etc/sing-box/config.json

if systemctl is-active --quiet sing-box 2>/dev/null && [[ -f /etc/freshvps/vpn-users.json ]]; then
  n="$(jq '[.users[] | select(.enabled==true)] | length' /etc/freshvps/vpn-users.json 2>/dev/null || echo 0)"
  if [[ "${n}" -eq 0 ]]; then
    echo "FAIL enabled VPN users (0) — sing-box has nobody to accept"
    fail=$((fail+1))
  else
    echo "OK   enabled VPN users (${n})"
    ok=$((ok+1))
  fi
fi

check "blocky unit" systemctl is-active blocky
check "dns localhost" dig +time=2 +tries=1 @127.0.0.1 example.com +short

if command -v docker >/dev/null 2>&1; then
  warn_check "compose panels.yml" test -f /opt/freshvps/compose/panels.yml
  for c in opensoho uptime-kuma beszel lampac; do
    if docker inspect "${c}" >/dev/null 2>&1; then
      if _container_running "${c}"; then
        echo "OK   container ${c}"
        ok=$((ok+1))
      else
        echo "WARN container ${c}"
        warnn=$((warnn+1))
      fi
    fi
  done
fi

if [[ -f /etc/systemd/system/freshvps-api.service ]] || systemctl cat freshvps-api >/dev/null 2>&1; then
  warn_check "api unit" systemctl is-active freshvps-api
  warn_check "api health" curl -fsS --max-time 2 http://127.0.0.1:8787/health
  warn_check "admin ui" curl -fsS -o /dev/null --max-time 2 http://127.0.0.1:8787/admin/
fi

if [[ -f /etc/systemd/system/freshvps-metrics.timer ]]; then
  warn_check "metrics timer" systemctl is-active freshvps-metrics.timer
  if [[ -f /var/lib/freshvps/metrics/latest.json ]]; then
    echo "OK   metrics latest.json"
    ok=$((ok+1))
  else
    echo "WARN metrics latest.json missing"
    warnn=$((warnn+1))
  fi
fi

echo
echo "Summary: ok=${ok} fail=${fail} warn=${warnn}"
[[ "${fail}" -eq 0 ]]
